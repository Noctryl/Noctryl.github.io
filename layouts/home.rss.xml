{{- $pages := .Site.RegularPages.ByDate.Reverse -}}
{{- $limit := .Site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 -}}
  {{- $pages = $pages | first $limit -}}
{{- end -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>{{ .Site.Title | htmlUnescape | transform.XMLEscape | safeHTML }}</title>
    <link>{{ .Site.BaseURL | htmlUnescape | transform.XMLEscape | safeHTML }}</link>
    <description>{{ .Site.Params.Subtitle | htmlUnescape | transform.XMLEscape | safeHTML }}</description>
    <language>{{ .Site.Language.LanguageCode | htmlUnescape | transform.XMLEscape | safeHTML }}</language>
    <generator>Hugo</generator>
    {{- with .OutputFormats.Get "RSS" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{- end }}
    {{- range $pages }}
    <item>
      <title>{{ .Title | htmlUnescape | transform.XMLEscape | safeHTML }}</title>
      <link>{{ .Permalink | transform.XMLEscape | safeHTML }}</link>
      <guid isPermaLink="true">{{ .Permalink | transform.XMLEscape | safeHTML }}</guid>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <description>{{ .Summary | htmlUnescape | plainify | transform.XMLEscape | safeHTML }}</description>
      <content:encoded>{{ .Content | htmlUnescape | transform.XMLEscape | safeHTML }}</content:encoded>
    </item>
    {{- end }}
  </channel>
</rss>
